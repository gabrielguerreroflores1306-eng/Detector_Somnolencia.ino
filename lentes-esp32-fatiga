#include <WiFi.h>
#include <esp_wifi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>

// --- CONFIGURACIÓN DE RED Y TELEGRAM ---
const char* ssid = "IoTNet";
const char* password = "11112222";

String botToken = "9197373664:AAHtmkGadsu09L0vnvblN86FtrCf9G-HJPg";     
String chatId = "1679495937";         

// --- DEFINICIÓN DE PINES Y PARÁMETROS ---
const int pinSensor = 2;   // OUT del sensor FC-51
const int pinSalidas = 10; // Hacia la base del transistor BC547 (Zumbador/Vibrador)

unsigned long tiempoInicioCerrado = 0;
bool ojoCerrado = false;
int avisosEnviados = 0;      
int incidenciaActual = 0;    

const unsigned long UMBRAL_ALERTA_MS = 2000;         
const unsigned long INTERVALO_RECURRENTE_MS = 2000;  
const unsigned long UMBRAL_CRITICO_MS = 5000;        

int totalIncidencias = 0;
unsigned long ultimaDuracionCierre = 0;

WiFiServer server(80);

// Estructura para pasar datos a la tarea de Telegram de forma segura
struct MensajeTelegram {
  unsigned long duracionMs;
  int contador;
  int tipoMensaje; // 1: Inicial, 2: Recurrente, 3: Cierre
};

// Cola de mensajes para FreeRTOS (evita que el loop se congele)
QueueHandle_t colaTelegram;

// --- TAREA EN SEGUNDO PLANO PARA TELEGRAM (Corre en paralelo lógico)൪
void tareaTelegram(void *pvParameters) {
  MensajeTelegram msg;
  while (true) {
    // Espera a que haya un mensaje en la cola sin bloquear el ESP32
    if (xQueueReceive(colaTelegram, &msg, portMAX_DELAY) == pdPASS) {
      if (WiFi.status() == WL_CONNECTED) {
        WiFiClientSecure clientSecure;
        clientSecure.setInsecure(); 

        HTTPClient http;
        String url = "https://api.telegram.org/bot" + botToken + "/sendMessage";
        
        http.begin(clientSecure, url);
        http.addHeader("Content-Type", "application/json");

        float duracionSeg = msg.duracionMs / 1000.0;
        String texto = "";

        if (msg.tipoMensaje == 1) {
          texto = "🚨 *¡ALERTA DE FATIGA INICIAL!* 🚨\n\n👁️ *Umbral:* " + String(duracionSeg, 2) + "s\n🔢 *Incidencia N°:* " + String(msg.contador) + "\n⚡ *Acción:* Actuadores encendidos.";
        } else if (msg.tipoMensaje == 2) {
          if (msg.duracionMs >= UMBRAL_CRITICO_MS) {
            texto = "🚨 *¡ADVERTENCIA CRÍTICA (>5s)!* 🚨\n\n💤 *Conductor dormido.*\n⏱️ *Acumulado:* " + String(duracionSeg, 2) + "s\n🔢 *Incidencia N°:* " + String(msg.contador);
          } else {
            texto = "⚠️ *¡AVISO RECURRENTE DE SUEÑO!* ⚠️\n\n⏱️ *Acumulado:* " + String(duracionSeg, 2) + "s\n🔢 *Incidencia N°:* " + String(msg.contador);
          }
        } else if (msg.tipoMensaje == 3) {
          texto = "✅ *¡INCIDENTE FINALIZADO!* ✅\n\n👁️ *Ojos abiertos.*\n⏱️ *Duración total:* " + String(duracionSeg, 2) + "s\n🔢 *Incidencia N°:* " + String(msg.contador);
        }

        String jsonBody = "{\"chat_id\":\"" + chatId + "\", \"text\":\"" + texto + "\", \"parse_mode\":\"Markdown\"}";
        http.POST(jsonBody);
        http.end();
      }
    }
  }
}

// Función auxiliar para enviar a la cola sin bloquear
void encolarTelegram(unsigned long duracion, int contador, int tipo) {
  MensajeTelegram msg = {duracion, contador, tipo};
  xQueueSend(colaTelegram, &msg, 0);
}

void setup() {
  Serial.begin(115200);
  btStop(); 

  pinMode(pinSensor, INPUT_PULLUP);
  pinMode(pinSalidas, OUTPUT);
  digitalWrite(pinSalidas, LOW); 

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  WiFi.setTxPower(WIFI_POWER_8_5dBm); 

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  // Crear la cola y la tarea independiente en FreeRTOS
  colaTelegram = xQueueCreate(10, sizeof(MensajeTelegram));
  xTaskCreatePinnedToCore(
    tareaTelegram,   // Función de la tarea
    "TelegramTask",  // Nombre
    4096,            // Memoria Stack
    NULL,            // Parámetros
    1,               // Prioridad
    NULL, 
    0                // Núcleo 0
  );

  server.begin();
}

void loop() {
  // --- 1. LÓGICA DE DETECCIÓN FÍSICA CRÍTICA (Sin bloqueos) ---
  int estadoSensor = digitalRead(pinSensor);

  if (estadoSensor == LOW) { // Ojos cerrados
    if (!ojoCerrado) {
      tiempoInicioCerrado = millis();
      ojoCerrado = true;
      avisosEnviados = 0; 
    } else {
      unsigned long tiempoTranscurrido = millis() - tiempoInicioCerrado;
      ultimaDuracionCierre = tiempoTranscurrido; 
      
      if (tiempoTranscurrido >= UMBRAL_ALERTA_MS) {
        digitalWrite(pinSalidas, HIGH); // Activa zumbador y motor al instante

        if (avisosEnviados == 0) {
          totalIncidencias++;
          incidenciaActual = totalIncidencias; 
          encolarTelegram(tiempoTranscurrido, incidenciaActual, 1); // Envía a segundo plano
          avisosEnviados = 1;
        } else {
          unsigned long tiempoEsperado = UMBRAL_ALERTA_MS + (avisosEnviados * INTERVALO_RECURRENTE_MS);
          if (tiempoTranscurrido >= tiempoEsperado) {
            encolarTelegram(tiempoTranscurrido, incidenciaActual, 2); // Envía a segundo plano
            avisosEnviados++;
          }
        }
      }
    }
  } else { // Ojos abiertos -> RESPUESTA FÍSICA INMEDIATA
    digitalWrite(pinSalidas, LOW); // Corta la electricidad al motor y zumbador al microsegundo

    if (ojoCerrado) {
      if (avisosEnviados > 0) {
        encolarTelegram(ultimaDuracionCierre, incidenciaActual, 3); // Cierre a segundo plano
      }
      ojoCerrado = false;
      avisosEnviados = 0;
    }
  }

  // --- 2. GESTIÓN WEB LOCAL (No bloqueante) ---
  WiFiClient client = server.available();
  if (client) {
    String peticionHttp = "";
    unsigned long timeoutHttp = millis();
    while (client.connected() && millis() - timeoutHttp < 150) {
      if (client.available()) {
        char c = client.read();
        peticionHttp += c;
        if (c == '\n') break;
      }
    }

    if (peticionHttp.indexOf("GET /RESET") >= 0) {
      totalIncidencias = 0; 
    }

    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: text/html; charset=utf-8");
    client.println("Cache-Control: no-store, no-cache, must-revalidate, max-age=0");
    client.println("Connection: close");
    client.println();
    
    client.println("<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'>");
    client.println("<meta name='viewport' content='width=device-width, initial-scale=1.0'>");
    client.println("<meta http-equiv='refresh' content='2'>");
    client.println("<title>Monitor de Somnolencia IoT</title>");
    client.println("<style>");
    client.println("body { font-family: Arial, sans-serif; background: #121212; color: #fff; text-align: center; padding: 20px; }");
    client.println(".card { background: #1e1e1e; padding: 20px; margin: 15px auto; max-width: 400px; border-radius: 12px; }");
    client.println("h1 { color: #00e676; font-size: 1.5em; }");
    client.println(".metric { font-size: 2em; font-weight: bold; color: #ff5252; }");
    client.println(".status { font-size: 1.2em; padding: 10px; border-radius: 8px; margin-top: 10px; }");
    client.println(".ok { background: #1b5e20; color: #81c784; }");
    client.println(".alert { background: #b71c1c; color: #ff8a80; }");
    client.println("</style></head><body>");
    
    client.println("<h1>MONITOR DE FATIGA ESP32-C3</h1>");
    client.println("<div class='card'><h3>Estado Actual</h3>");
    if (ojoCerrado) {
      client.println("<div class='status alert'>⚠️ ALERTA: OJO CERRADO</div>");
    } else {
      client.println("<div class='status ok'>🟢 CONDUCTOR ALERTA</div>");
    }
    client.println("</div>");
    client.println("<div class='card'><h3>Incidencias</h3><div class='metric'>" + String(totalIncidencias) + "</div></div>");
    client.println("<br><a href='/RESET' style='color: #00e676;'>[ Reiniciar Contador ]</a>");
    client.println("</body></html>");
    client.stop();
  }
}
